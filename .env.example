# Copiar a .env (raíz) y backend/.env — valores de ejemplo para desarrollo local

# --- PostgreSQL ---
DB_HOST=localhost
# Si ya tienes PostgreSQL instalado en Windows usando el 5432, cambia a 5433
DB_PORT=5432
DB_USER=biess
DB_PASSWORD=biess_secret
DB_NAME=biess_postulacion
DB_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- API ---
API_PORT=8080
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_TTL_HOURS=2
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Reglas de seguridad (EF-11) ---
MAX_INTENTOS=3
BLOQUEO_MINUTOS=10
CATALOGO_TTL_HORAS=24

# --- Solo sustentación: fuerza un error al enviar para demostrar el ROLLBACK ---
DEMO_FALLA_ENVIO=false

# --- Registro Civil simulado: una cédula válida desconocida se da de alta con datos ficticios ---
REGISTRO_CIVIL_AUTOGENERAR=true

# --- Correo (Brevo): sin estos datos no se envía ningún correo ---
BREVO_API_KEY=
MAIL_REMITENTE=
MAIL_REMITENTE_NOMBRE=Concurso Directorio BIESS
# Solo demostraciones sin correo: muestra en pantalla el enlace para recuperar la contraseña
RECUPERACION_ENLACE_EN_PANTALLA=false

# --- Primer administrador del módulo EF-13: se crea al arrancar si no existe ---
ADMIN_USUARIO=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador del concurso
