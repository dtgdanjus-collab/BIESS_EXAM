# Copiar a backend/.env. Si no existe, el backend usa el .env de la raíz del repositorio.

# --- PostgreSQL ---
DB_HOST=localhost
# Si ya tienes PostgreSQL instalado en Windows usando el 5432, cambia a 5433
DB_PORT=5432
DB_USER=biess
DB_PASSWORD=biess_secret
DB_NAME=biess_postulacion
DB_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- API ---
API_PORT=8080
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_TTL_HOURS=2
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Reglas de seguridad (EF-11) ---
MAX_INTENTOS=3
BLOQUEO_MINUTOS=10
CATALOGO_TTL_HORAS=24

# --- Solo sustentación: fuerza un error al enviar para demostrar el ROLLBACK ---
DEMO_FALLA_ENVIO=false
